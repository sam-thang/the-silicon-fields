{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesiliconfields.com/schema/project.schema.json",
  "title": "The Silicon Fields project record",
  "description": "One curated data center project. Cross-field rules (source references, status/date consistency, publication rules) are enforced in scripts/validate.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug", "name", "owner", "country", "region", "locality",
    "lat", "lon", "location_precision", "capacity_mw", "status", "status_note",
    "dates", "sources", "verification", "approved", "last_verified"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "developer": { "type": "string" },
    "tenant": { "type": "string" },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2" },
    "region": { "type": "string", "minLength": 1 },
    "locality": { "type": "string", "minLength": 1 },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "location_precision": {
      "enum": ["site", "town", "city", "county", "region", "state"],
      "description": "region and state mean the point is approximate: draw a soft circle, not a sharp column base."
    },
    "capacity_mw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high", "type"],
      "properties": {
        "low": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "high": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "type": {
          "enum": [
            "planned_campus", "it_load_estimate", "facility_power_permit", "estimate",
            "mixed", "unknown", "power_generation", "grid_switchyard", "utility_contract"
          ]
        },
        "note": { "type": "string" }
      }
    },
    "status": {
      "enum": ["announced", "permitting", "under_construction", "partially_operational", "operational", "paused", "cancelled"]
    },
    "status_note": { "type": "string", "minLength": 1 },
    "expected_completion": { "type": ["string", "null"] },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "announced": { "$ref": "#/$defs/dated" },
        "construction_start": { "$ref": "#/$defs/dated" },
        "operational": { "$ref": "#/$defs/dated" },
        "paused": { "$ref": "#/$defs/dated" },
        "cancelled": { "$ref": "#/$defs/dated" }
      }
    },
    "investment_usd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "est"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0 },
        "est": { "type": ["boolean", "null"] }
      }
    },
    "area_acres": { "type": ["number", "null"], "minimum": 0 },
    "imagery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before_date": { "type": "string" },
        "after_date": { "type": "string" }
      }
    },
    "local_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "summary", "source_id"],
        "properties": {
          "type": { "enum": ["tax_incentive", "permit", "opposition", "ballot", "utility_deal"] },
          "summary": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "url", "accessed", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "accessed": { "type": "string", "format": "date" },
          "kind": {
            "enum": ["primary", "news", "satellite", "tracker", "secondary"],
            "description": "primary/news/satellite count as evidence; tracker and secondary never count on their own."
          }
        }
      }
    },
    "verification": { "enum": ["primary", "news", "tracker_only"] },
    "approved": { "type": "boolean" },
    "review_notes": { "type": "string" },
    "last_verified": { "type": "string", "format": "date" }
  },
  "$defs": {
    "dated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "precision", "source_ids"],
      "properties": {
        "value": { "type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2])|-Q[1-4])?$" },
        "precision": { "enum": ["month", "quarter", "year"] },
        "basis": {
          "enum": ["reported_start", "first_evidence"],
          "description": "first_evidence: no published start date; this is the first sourced evidence of construction."
        },
        "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    }
  }
}
